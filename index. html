<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nandlal Fitness – Personal Training & Strength Coaching</title>
<meta name="description" content="One-to-one personal training, strength programs and nutrition coaching with Nandlal.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --slate:#0E2A33; --slate-2:#143842; --chalk:#F2F5F3; --steel:#9FB2B8;
  --saffron:#F29F05; --ink:#0A1D23;
  --head:'Big Shoulders Display','Arial Narrow',Impact,sans-serif;
  --body:'Manrope',system-ui,-apple-system,'Segoe UI',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);background:var(--slate);color:var(--chalk);line-height:1.65;font-size:17px}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--saffron);outline-offset:3px}
.wrap{max-width:1160px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--head);font-weight:800;line-height:.95;letter-spacing:.01em}
h2{font-size:clamp(2.6rem,6vw,4.4rem);margin-bottom:18px}
p.lead{color:var(--steel);max-width:56ch}
section{padding:110px 0}

/* nav */
header{position:sticky;top:0;z-index:20;background:rgba(14,42,51,.92);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,.08)}
nav{display:flex;align-items:center;justify-content:space-between;height:72px}
.logo{font-family:var(--head);font-size:1.9rem;font-weight:900;letter-spacing:.03em}
.logo span{color:var(--saffron)}
.links{display:flex;gap:32px;align-items:center;font-weight:600;font-size:.95rem}
.links a:hover{color:var(--saffron)}
.btn{display:inline-block;background:var(--saffron);color:var(--ink);font-weight:700;padding:15px 30px;border-radius:4px;transition:transform .2s,background .2s;border:0;cursor:pointer;font:inherit;font-weight:700}
.btn:hover{transform:translateY(-2px);background:#ffb52e}
.btn.ghost{background:transparent;color:var(--chalk);border:1.5px solid rgba(255,255,255,.35)}
.btn.ghost:hover{border-color:var(--saffron);color:var(--saffron);background:transparent}
.links .btn{padding:10px 22px}

/* hero */
.hero{padding:90px 0 100px;position:relative;overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1.3fr .9fr;gap:40px;align-items:center}
.hero h1{font-size:clamp(4rem,11vw,9rem);text-transform:uppercase;margin-bottom:28px}
.hero h1 em{font-style:normal;color:transparent;-webkit-text-stroke:2px var(--saffron)}
.hero p{color:var(--steel);max-width:46ch;margin-bottom:36px;font-size:1.1rem}
.cta{display:flex;gap:14px;flex-wrap:wrap}
.plate{position:relative;aspect-ratio:1;max-width:420px;margin:auto;width:100%}
.plate i{position:absolute;border-radius:50%;inset:0;border:2px solid rgba(255,255,255,.12)}
.plate i:nth-child(2){inset:12%;border-color:rgba(242,159,5,.5)}
.plate i:nth-child(3){inset:26%;background:var(--slate-2);border-color:rgba(255,255,255,.18)}
.plate i:nth-child(4){inset:44%;background:var(--saffron);border:0}
.plate b{position:absolute;inset:0;display:grid;place-content:center;text-align:center;font-family:var(--head);z-index:2}
.plate b strong{font-size:5.2rem;line-height:.9;color:var(--chalk)}
.plate b small{font-size:1.1rem;color:var(--steel);font-family:var(--body);font-weight:600}
.plate{animation:spin-in 1.1s cubic-bezier(.2,.8,.2,1) both}
@keyframes spin-in{from{opacity:0;transform:rotate(-80deg) scale(.85)}to{opacity:1;transform:none}}
.stats{display:flex;gap:48px;margin-top:56px;padding-top:28px;border-top:1px solid rgba(255,255,255,.12);flex-wrap:wrap}
.stats div strong{display:block;font-family:var(--head);font-size:2.6rem;line-height:1}
.stats div span{color:var(--steel);font-size:.9rem}

/* programs */
.light{background:var(--chalk);color:var(--ink)}
.light p.lead{color:#4a5e65}
.programs{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:56px;border-top:2px solid var(--ink)}
.prog{padding:36px 30px 40px 0;border-right:1px solid rgba(10,29,35,.18)}
.prog:not(:first-child){padding-left:30px}
.prog:last-child{border-right:0}
.prog h3{font-size:2.3rem;margin-bottom:12px}
.prog p{color:#4a5e65;margin-bottom:18px}
.prog ul{list-style:none;font-weight:600;font-size:.95rem}
.prog li{padding:8px 0;border-top:1px solid rgba(10,29,35,.12)}
.prog li::before{content:"+";color:var(--saffron);font-weight:800;margin-right:10px}

/* coach */
.coach{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.portrait{aspect-ratio:4/5;background:linear-gradient(160deg,var(--slate-2),var(--ink));border-radius:6px;position:relative;display:grid;place-items:center;overflow:hidden}
.portrait span{font-family:var(--head);font-weight:900;font-size:clamp(9rem,22vw,16rem);color:rgba(242,159,5,.9);line-height:1}
.portrait small{position:absolute;bottom:20px;left:22px;color:var(--steel);font-size:.85rem}
.creds{margin-top:28px;display:grid;gap:14px}
.creds div{padding-left:18px;border-left:3px solid var(--saffron);color:var(--chalk)}
.creds div span{display:block;color:var(--steel);font-size:.9rem}

/* results */
.results{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:50px}
.result{background:var(--slate-2);padding:32px;border-radius:6px}
.result strong{font-family:var(--head);font-size:3.4rem;color:var(--saffron);line-height:1;display:block}
.result h3{font-size:1.5rem;margin:10px 0}
.result p{color:var(--steel);font-size:.95rem;margin-bottom:18px}
.result footer{font-weight:700;font-size:.9rem}

/* pricing */
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:50px;align-items:stretch}
.plan{background:#fff;border:1.5px solid rgba(10,29,35,.15);border-radius:6px;padding:36px 30px;display:flex;flex-direction:column}
.plan.best{background:var(--slate);color:var(--chalk);border-color:var(--slate);transform:translateY(-14px)}
.plan h3{font-size:2rem}
.price{font-family:var(--head);font-size:4rem;font-weight:800;line-height:1;margin:14px 0 4px}
.price small{font-size:1rem;font-family:var(--body);font-weight:500;opacity:.7}
.plan ul{list-style:none;margin:22px 0 30px;flex:1}
.plan li{padding:9px 0;border-top:1px solid rgba(128,128,128,.25);font-size:.95rem}
.plan .btn{text-align:center}
.plan:not(.best) .btn{background:var(--ink);color:var(--chalk)}
.plan:not(.best) .btn:hover{background:var(--saffron);color:var(--ink)}

/* contact */
.contact{display:grid;grid-template-columns:1fr 1fr;gap:70px}
form{display:grid;gap:16px}
label{font-weight:600;font-size:.9rem;display:grid;gap:6px}
input,select,textarea{font:inherit;padding:14px;border-radius:4px;border:1.5px solid rgba(255,255,255,.2);background:var(--slate-2);color:var(--chalk)}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--saffron)}
textarea{min-height:110px;resize:vertical}
.details{display:grid;gap:22px;margin-top:30px}
.details strong{display:block;font-family:var(--head);font-size:1.5rem}
.details span{color:var(--steel)}
#msg{color:var(--saffron);font-weight:600;min-height:1.5em}

footer.site{padding:32px 0;border-top:1px solid rgba(255,255,255,.1);color:var(--steel);font-size:.9rem}
footer.site .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}

@media(max-width:900px){
  section{padding:80px 0}
  .links a:not(.btn){display:none}
  .hero-grid,.coach,.contact{grid-template-columns:1fr}
  .plate{max-width:280px;order:-1}
  .programs,.results,.plans{grid-template-columns:1fr}
  .prog,.prog:not(:first-child){padding:30px 0;border-right:0;border-bottom:1px solid rgba(10,29,35,.18)}
  .plan.best{transform:none}
  .portrait{max-width:380px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>

<header>
  <nav class="wrap" aria-label="Main">
    <a href="#top" class="logo">NANDLAL<span>.</span></a>
    <div class="links">
      <a href="#programs">Programs</a>
      <a href="#coach">Coach</a>
      <a href="#results">Results</a>
      <a href="#pricing">Pricing</a>
      <a href="#contact" class="btn">Book a free session</a>
    </div>
  </nav>
</header>

<main id="top">
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <h1>Build a body that <em>performs.</em></h1>
          <p>One-to-one strength coaching, structured programming and practical nutrition from Nandlal. Real plans, tracked weekly, built around your schedule.</p>
          <div class="cta">
            <a href="#contact" class="btn">Book a free session</a>
            <a href="#programs" class="btn ghost">See programs</a>
          </div>
        </div>
        <div class="plate" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
          <b><strong>12</strong><small>weeks to your first<br>visible change</small></b>
        </div>
      </div>
      <div class="stats">
        <div><strong>10+</strong><span>Years coaching</span></div>
        <div><strong>450+</strong><span>Clients trained</span></div>
        <div><strong>4.9/5</strong><span>Average client rating</span></div>
      </div>
    </div>
  </section>

  <section class="light" id="programs">
    <div class="wrap">
      <h2>Three ways to train</h2>
      <p class="lead">Every program starts with an assessment of your strength, mobility and goals, then adjusts every two weeks as you progress.</p>
      <div class="programs">
        <article class="prog">
          <h3>Strength &amp; Muscle</h3>
          <p>Progressive lifting for size, power and joint health.</p>
          <ul><li>4-day split with tracked loads</li><li>Technique coaching on main lifts</li><li>Monthly strength testing</li></ul>
        </article>
        <article class="prog">
          <h3>Fat Loss</h3>
          <p>Training and nutrition that cut body fat without crash diets.</p>
          <ul><li>Calorie and protein targets</li><li>Weekly check-ins and adjustments</li><li>Conditioning blocks</li></ul>
        </article>
        <article class="prog">
          <h3>Mobility &amp; Recovery</h3>
          <p>Move well, stay pain-free and return from injury safely.</p>
          <ul><li>Posture and mobility screening</li><li>Low-impact strength work</li><li>Home routines you can repeat</li></ul>
        </article>
      </div>
    </div>
  </section>

  <section id="coach">
    <div class="wrap coach">
      <div class="portrait" role="img" aria-label="Portrait placeholder for Nandlal"><span>N</span><small>Replace with Nandlal's photo</small></div>
      <div>
        <h2>Coached by Nandlal</h2>
        <p class="lead">I train people who are tired of guessing. You get a clear plan, honest feedback and a coach who tracks your progress every week.</p>
        <div class="creds">
          <div>Certified Personal Trainer<span>Strength and conditioning specialist</span></div>
          <div>Nutrition coaching certified<span>Simple, sustainable eating plans</span></div>
          <div>Training in-person and online<span>Gym sessions or remote coaching</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="results" style="background:var(--ink)">
    <div class="wrap">
      <h2>Client results</h2>
      <p class="lead">Real changes from people who showed up consistently.</p>
      <div class="results">
        <article class="result"><strong>-14 kg</strong><h3>In 20 weeks</h3><p>Rahul started with desk-job fatigue and no routine. He now trains four days a week.</p><footer>Rahul S., Fat Loss</footer></article>
        <article class="result"><strong>+40 kg</strong><h3>On his deadlift</h3><p>Aman fixed his form, built a base and added strength steadily without injury.</p><footer>Aman K., Strength</footer></article>
        <article class="result"><strong>Pain-free</strong><h3>After 8 weeks</h3><p>Priya returned to training after a back strain with a clear, gradual plan.</p><footer>Priya M., Recovery</footer></article>
      </div>
    </div>
  </section>

  <section class="light" id="pricing">
    <div class="wrap">
      <h2>Simple pricing</h2>
      <p class="lead">No joining fees. Cancel any time with 30 days' notice.</p>
      <div class="plans">
        <article class="plan">
          <h3>Online Coaching</h3>
          <div class="price">₹3,999<small> / month</small></div>
          <ul><li>Custom program in your app</li><li>Weekly check-in</li><li>Nutrition guidelines</li></ul>
          <a href="#contact" class="btn">Choose Online</a>
        </article>
        <article class="plan best">
          <h3>Personal Training</h3>
          <div class="price">₹9,999<small> / month</small></div>
          <ul><li>12 one-to-one sessions</li><li>Full nutrition plan</li><li>Weekly progress review</li><li>Chat support</li></ul>
          <a href="#contact" class="btn">Choose Personal</a>
        </article>
        <article class="plan">
          <h3>Small Group</h3>
          <div class="price">₹5,499<small> / month</small></div>
          <ul><li>3 sessions a week</li><li>Groups of up to 4</li><li>Monthly assessment</li></ul>
          <a href="#contact" class="btn">Choose Group</a>
        </article>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap contact">
      <div>
        <h2>Book your free session</h2>
        <p class="lead">Tell me your goal. I'll reply within 24 hours to arrange a 30-minute assessment.</p>
        <div class="details">
          <div><strong>Call or WhatsApp</strong><span>+91 00000 00000</span></div>
          <div><strong>Email</strong><span>hello@nandlalfitness.com</span></div>
          <div><strong>Training hours</strong><span>Mon–Sat, 5:30 am – 9:00 pm</span></div>
        </div>
      </div>
      <form id="form">
        <label>Full name<input name="name" required autocomplete="name"></label>
        <label>Phone or email<input name="contact" required></label>
        <label>Main goal
          <select name="goal"><option>Build muscle and strength</option><option>Lose fat</option><option>Mobility and recovery</option><option>Not sure yet</option></select>
        </label>
        <label>Anything I should know?<textarea name="note"></textarea></label>
        <button class="btn" type="submit">Send request</button>
        <p id="msg" role="status"></p>
      </form>
    </div>
  </section>
</main>

<footer class="site">
  <div class="wrap"><span>© 2026 Nandlal Fitness</span><span>Train with purpose.</span></div>
</footer>

<script>
document.getElementById('form').addEventListener('submit',function(e){
  e.preventDefault();
  document.getElementById('msg').textContent='Request sent. Nandlal will reply within 24 hours.';
  this.reset();
});
</script>
</body>
</html>
